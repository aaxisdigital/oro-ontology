{% extends '@OroUI/actions/index.html.twig' %}

{% set pageTitle = flow ? flow.name : 'aaxis.ontology.flow_editor.title'|trans %}

{% block content %}
    <div class="layout-content">
        <div class="content"
             data-page-component-module="aaxisontology/js/app/components/flow-editor-component"
             data-page-component-options="{{ {
                 flow: flow,
                 gridSpacing: gridSpacing,
                 stepSizeFactor: stepSizeFactor,
                 listUrl: path('aaxis_ontology_flows')
             }|json_encode }}">

            <div class="aaxis-flow-editor" data-role="editor">
                <div class="aaxis-flow-editor__topbar">
                    {# Labels sit ABOVE their controls to keep the left side narrow. #}
                    {# The flow's name lives on its TRIGGER STEP and shows as the TAB title below. #}
                    {# Every button: icon + a text span that a <1200px viewport hides (icon-only mode). #}
                    <div class="aaxis-flow-editor__controls">
                        <button type="button" class="btn" data-role="toolbox-toggle"
                                title="{{ 'aaxis.ontology.flow_editor.toolbox_toggle'|trans }}">
                            <span class="fa fa-wrench" aria-hidden="true"></span>
                            <span class="aaxis-flow-editor__btn-text">{{ 'aaxis.ontology.flow_editor.toolbox_toggle'|trans }}</span>
                        </button>
                        {# Lays every step out in execution order, wrapping rows at the viewport width. #}
                        <button type="button" class="btn" data-role="organize" hidden
                                title="{{ 'aaxis.ontology.flow_editor.organize'|trans }}">
                            <span class="fa fa-th" aria-hidden="true"></span>
                            <span class="aaxis-flow-editor__btn-text">{{ 'aaxis.ontology.flow_editor.organize'|trans }}</span>
                        </button>
                        {# Debugging is only offered for flows that contain a trigger (kept in sync by the
                           component): Debug steps through the flow one step at a time, Run Now executes it all. #}
                        <button type="button" class="btn" data-role="debug-step" hidden
                                title="{{ 'aaxis.ontology.flow_editor.debug'|trans }}">
                            <span class="fa fa-bug" aria-hidden="true"></span>
                            <span class="aaxis-flow-editor__btn-text">{{ 'aaxis.ontology.flow_editor.debug'|trans }}</span>
                        </button>
                        <button type="button" class="btn" data-role="debug" hidden
                                title="{{ 'aaxis.ontology.flow_editor.run_now'|trans }}">
                            <span class="fa fa-play" aria-hidden="true"></span>
                            <span class="aaxis-flow-editor__btn-text">{{ 'aaxis.ontology.flow_editor.run_now'|trans }}</span>
                        </button>
                        {# Clean state at load: the exit button reads Close and Save is disabled until
                           something changes (the component syncs the LABEL span + title, not the button text,
                           so the icon survives). #}
                        <button type="button" class="btn" data-role="cancel"
                                title="{{ 'aaxis.ontology.flow_editor.close'|trans }}">
                            <span class="fa fa-times" aria-hidden="true"></span>
                            <span class="aaxis-flow-editor__btn-text" data-role="cancel-label">{{ 'aaxis.ontology.flow_editor.close'|trans }}</span>
                        </button>
                        <button type="button" class="btn btn-primary" data-role="save" disabled
                                title="{{ 'aaxis.ontology.flow_editor.save'|trans }}">
                            <span class="fa fa-check" aria-hidden="true"></span>
                            <span class="aaxis-flow-editor__btn-text">{{ 'aaxis.ontology.flow_editor.save'|trans }}</span>
                        </button>
                    </div>
                </div>

                {# The canvas is a scroll viewport over an inner content plane (data-role="canvas",
                   where steps/wires live and every coordinate is measured — its rect follows the
                   scroll). The toolbox floats OUTSIDE the scroller so it stays viewport-pinned.
                   The debugger sidebar (left of the design area) is filled and shown by the
                   component while a Debug / Run Now session is active. #}
                {# One tab per open flow (title = trigger name, • = unsaved, × = close) plus the
                   two ACTION tabs: open an existing flow / start a new one. #}
                <div class="aaxis-flow-editor__tabs" data-role="tabs"></div>

                <div class="aaxis-flow-editor__canvas-wrap">
                    <aside class="aaxis-flow-editor__debugger" data-role="debugger" hidden></aside>
                    <div class="aaxis-flow-editor__canvas" data-role="canvas-viewport">
                        <div class="aaxis-flow-editor__canvas-inner" data-role="canvas"></div>
                    </div>
                    <div class="aaxis-flow-editor__toolbox" data-role="toolbox">
                        <div class="aaxis-flow-editor__toolbox-handle" data-role="toolbox-handle">
                            {# Same icon as the topbar's show/hide Toolbox button. #}
                            <span class="fa fa-wrench" aria-hidden="true"></span>
                            {{ 'aaxis.ontology.flow_editor.toolbox.title'|trans }}
                            <button type="button" class="aaxis-flow-editor__toolbox-hide" data-role="toolbox-hide"
                                    title="{{ 'aaxis.ontology.flow_editor.toolbox.hide'|trans }}"
                                    aria-label="{{ 'aaxis.ontology.flow_editor.toolbox.hide'|trans }}">
                                <span class="fa fa-times" aria-hidden="true"></span>
                            </button>
                        </div>
                        <div class="aaxis-flow-editor__toolbox-body" data-role="toolbox-body">
                        {% set sections = [
                            {key: 'triggers', category: 'trigger', items: [
                                {key: 'cron', icon: 'fa-clock-o'},
                                {key: 'endpoint', icon: 'fa-plug'},
                                {key: 'entity_change', icon: 'fa-database'},
                                {key: 'subflow', icon: 'fa-sign-in'}
                            ]},
                            {key: 'flow_control', category: 'action', items: [
                                {key: 'choice', icon: 'fa-code-fork'},
                                {key: 'sub_flow', icon: 'fa-sitemap'},
                                {key: 'foreach', icon: 'fa-repeat'}
                            ]},
                            {key: 'operations', category: 'operation', items: [
                                {key: 'dwl_transform', icon: 'fa-random'},
                                {key: 'entity_read', icon: 'fa-download'},
                                {key: 'entity_write', icon: 'fa-upload'},
                                {key: 'invoke', icon: 'fa-bolt'},
                                {key: 'sql_query', icon: 'fa-table'}
                            ]},
                            {key: 'file_operations', category: 'operation', items: [
                                {key: 'file_read', icon: 'fa-file-text-o'},
                                {key: 'file_write', icon: 'fa-pencil-square-o'},
                                {key: 'file_list', icon: 'fa-folder-open-o'},
                                {key: 'file_delete', icon: 'fa-trash-o'},
                                {key: 'file_rename', icon: 'fa-i-cursor'}
                            ]}
                        ] %}
                        {% for section in sections %}
                            <div class="aaxis-flow-editor__toolbox-section">
                                <div class="aaxis-flow-editor__toolbox-section-title">
                                    {{ ('aaxis.ontology.flow_editor.toolbox.section.' ~ section.key)|trans }}
                                    <button type="button" class="aaxis-flow-editor__toolbox-section-toggle"
                                            data-role="toolbox-section-toggle"
                                            title="{{ 'aaxis.ontology.flow_editor.toolbox.collapse'|trans }}"
                                            aria-label="{{ 'aaxis.ontology.flow_editor.toolbox.collapse'|trans }}">
                                        <span class="fa fa-minus" aria-hidden="true"></span>
                                    </button>
                                </div>
                                {% for item in section.items %}
                                    <div class="aaxis-flow-editor__toolbox-item"
                                         data-step-type="{{ item.key }}"
                                         data-step-category="{{ section.category }}"
                                         data-step-icon="{{ item.icon }}"
                                         data-step-label="{{ ('aaxis.ontology.flow_editor.toolbox.item.' ~ item.key)|trans }}">
                                        <span class="fa {{ item.icon }} aaxis-flow-editor__toolbox-item-icon" aria-hidden="true"></span>
                                        {{ ('aaxis.ontology.flow_editor.toolbox.item.' ~ item.key)|trans }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
