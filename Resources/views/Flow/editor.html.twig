{% extends '@OroUI/actions/index.html.twig' %}

{% set pageTitle = flow ? flow.name : 'aaxis.ontology.flow_editor.title'|trans %}

{% block content %}
    <div class="layout-content">
        <div class="content"
             data-page-component-module="aaxisontology/js/app/components/flow-editor-component"
             data-page-component-options="{{ {
                 flow: flow,
                 gridSpacing: gridSpacing,
                 stepSizeFactor: stepSizeFactor,
                 debugAutoCloseSeconds: debugAutoCloseSeconds,
                 listUrl: path('aaxis_ontology_flows'),
                 connectorCreateUrl: is_granted('aaxis_ontology_connector_create') ? path('aaxis_ontology_connector_create') : null
             }|json_encode }}">

            <div class="aaxis-flow-editor" data-role="editor">
                {# The TAB BAR — the editor has no top bar. Left: one tab per open flow, rendered by the
                   component into tab-list (title = the trigger's name, • = unsaved, × = close). Right:
                   every editor action, icon-only (the titles are the labels), in two groups:
                   - CANVAS tools: toolbox show/hide (Organize behind its caret), Run Now (Debug
                     behind its caret);
                   - after a small gap, DOCUMENT tools: new, open, save, save all, view source,
                     history and × = close the editor (back to the flows list). #}
                <div class="aaxis-flow-editor__tabs" data-role="tabs">
                    <div class="aaxis-flow-editor__tab-list" data-role="tab-list"></div>
                    <div class="aaxis-flow-editor__tab-actions" data-role="tab-actions">
                        <div class="aaxis-flow-editor__tab-group" data-role="canvas-actions">
                            {# Two SPLIT controls: a main button plus a caret opening its sub-options.
                               Toolbox show/hide, with Organize (lays every step out in execution order,
                               wrapping rows at the viewport width; disabled without steps) behind it. #}
                            <div class="aaxis-flow-editor__split" data-role="toolbox-split">
                                <button type="button" class="aaxis-flow-editor__tab aaxis-flow-editor__tab--action aaxis-flow-editor__split-main" data-role="toolbox-toggle"
                                        title="{{ 'aaxis.ontology.flow_editor.tab_toolbox'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.tab_toolbox'|trans }}">
                                    <span class="fa fa-wrench" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="aaxis-flow-editor__tab aaxis-flow-editor__tab--action aaxis-flow-editor__split-caret" data-role="toolbox-menu-toggle"
                                        aria-haspopup="true" aria-expanded="false"
                                        title="{{ 'aaxis.ontology.flow_editor.toolbox_options'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.toolbox_options'|trans }}">
                                    <span class="fa fa-caret-down" aria-hidden="true"></span>
                                </button>
                                <div class="aaxis-flow-editor__menu aaxis-flow-editor__split-menu" data-role="toolbox-menu" role="menu" hidden>
                                    <button type="button" class="aaxis-flow-editor__menu-item" data-role="organize" role="menuitem" disabled
                                            title="{{ 'aaxis.ontology.flow_editor.organize'|trans }}">
                                        <span class="fa fa-th" aria-hidden="true"></span>{{ 'aaxis.ontology.flow_editor.organize'|trans }}
                                    </button>
                                </div>
                            </div>
                            {# Manual runs, offered only for flows that contain a trigger (kept in sync by the
                               component) and whether or not the flow is enabled — the trigger's switch gates the
                               AUTOMATIC runs only. Run Now executes everything; Debug (step by step) is its
                               sub-option behind the caret. #}
                            <div class="aaxis-flow-editor__split" data-role="run-split" hidden>
                                <button type="button" class="aaxis-flow-editor__tab aaxis-flow-editor__tab--action aaxis-flow-editor__split-main" data-role="debug"
                                        title="{{ 'aaxis.ontology.flow_editor.run_now'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.run_now'|trans }}">
                                    <span class="fa fa-play" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="aaxis-flow-editor__tab aaxis-flow-editor__tab--action aaxis-flow-editor__split-caret" data-role="run-menu-toggle"
                                        aria-haspopup="true" aria-expanded="false"
                                        title="{{ 'aaxis.ontology.flow_editor.run_options'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.run_options'|trans }}">
                                    <span class="fa fa-caret-down" aria-hidden="true"></span>
                                </button>
                                <div class="aaxis-flow-editor__menu aaxis-flow-editor__split-menu" data-role="run-menu" role="menu" hidden>
                                    <button type="button" class="aaxis-flow-editor__menu-item" data-role="debug-step" role="menuitem"
                                            title="{{ 'aaxis.ontology.flow_editor.debug'|trans }}">
                                        <span class="fa fa-bug" aria-hidden="true"></span>{{ 'aaxis.ontology.flow_editor.debug'|trans }}
                                    </button>
                                </div>
                            </div>
                        </div>
                        {# Save starts disabled (clean state) and History until the flow is saved — the
                           component keeps both in sync. "Save all" is two stacked floppies (FA 4 has no
                           such glyph). #}
                        {% set document_actions = [
                            {role: 'tab-add', icon: 'fa-file-o', label: 'aaxis.ontology.flow_editor.tab_add'},
                            {role: 'tab-open', icon: 'fa-folder-open-o', label: 'aaxis.ontology.flow_editor.tab_open'},
                            {role: 'save', icon: 'fa-floppy-o', label: 'aaxis.ontology.flow_editor.tab_save', disabled: true},
                            {role: 'save-all', icon: 'fa-floppy-o aaxis-flow-editor__save-all-back', label: 'aaxis.ontology.flow_editor.tab_save_all', disabled: true},
                            {role: 'view-source', icon: 'fa-code', label: 'aaxis.ontology.flow_editor.view_source'},
                            {role: 'flow-history', icon: 'fa-history', label: 'aaxis.ontology.flow_editor.history', disabled: true},
                            {role: 'tab-close-all', icon: 'fa-times', label: 'aaxis.ontology.flow_editor.tab_close_all', class: 'aaxis-flow-editor__tab--leave'}
                        ] %}
                        <div class="aaxis-flow-editor__tab-group" data-role="document-actions">
                            {% for action in document_actions %}
                                <button type="button" class="aaxis-flow-editor__tab aaxis-flow-editor__tab--action {{ action.class ?? '' }}" data-role="{{ action.role }}"
                                        title="{{ action.label|trans }}" aria-label="{{ action.label|trans }}"{% if action.disabled ?? false %} disabled{% endif %}>
                                    <span class="fa {{ action.icon }}" aria-hidden="true"></span>
                                    {%- if action.role == 'save-all' %}<span class="fa fa-floppy-o aaxis-flow-editor__save-all-front" aria-hidden="true"></span>{% endif %}
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="aaxis-flow-editor__canvas-wrap">
                    <aside class="aaxis-flow-editor__debugger" data-role="debugger" hidden></aside>
                    <div class="aaxis-flow-editor__canvas" data-role="canvas-viewport">
                        <div class="aaxis-flow-editor__canvas-inner" data-role="canvas"></div>
                    </div>
                    <div class="aaxis-flow-editor__toolbox" data-role="toolbox">
                        <div class="aaxis-flow-editor__toolbox-handle" data-role="toolbox-handle">
                            {# Same icon as the tab bar's show/hide Toolbox action. #}
                            <span class="fa fa-wrench" aria-hidden="true"></span>
                            {{ 'aaxis.ontology.flow_editor.toolbox.title'|trans }}
                            {# Expand / collapse EVERY section at once, then hide the toolbox. #}
                            <span class="aaxis-flow-editor__toolbox-tools">
                                <button type="button" class="aaxis-flow-editor__toolbox-tool" data-role="toolbox-expand-all"
                                        title="{{ 'aaxis.ontology.flow_editor.toolbox.expand_all'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.toolbox.expand_all'|trans }}">
                                    <span class="fa fa-plus-square-o" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="aaxis-flow-editor__toolbox-tool" data-role="toolbox-collapse-all"
                                        title="{{ 'aaxis.ontology.flow_editor.toolbox.collapse_all'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.toolbox.collapse_all'|trans }}">
                                    <span class="fa fa-minus-square-o" aria-hidden="true"></span>
                                </button>
                                <button type="button" class="aaxis-flow-editor__toolbox-tool aaxis-flow-editor__toolbox-hide" data-role="toolbox-hide"
                                        title="{{ 'aaxis.ontology.flow_editor.toolbox.hide'|trans }}"
                                        aria-label="{{ 'aaxis.ontology.flow_editor.toolbox.hide'|trans }}">
                                    <span class="fa fa-times" aria-hidden="true"></span>
                                </button>
                            </span>
                        </div>
                        <div class="aaxis-flow-editor__toolbox-body" data-role="toolbox-body">
                        {% set sections = [
                            {key: 'triggers', category: 'trigger', items: [
                                {key: 'cron', icon: 'fa-clock-o'},
                                {key: 'endpoint', icon: 'fa-plug'},
                                {key: 'entity_change', icon: 'fa-database'},
                                {key: 'subflow', icon: 'fa-sign-in'}
                            ]},
                            {key: 'flow_control', category: 'action', items: [
                                {key: 'choice', icon: 'fa-code-fork'},
                                {key: 'sub_flow', icon: 'fa-sitemap'},
                                {key: 'foreach', icon: 'fa-repeat'}
                            ]},
                            {key: 'operations', category: 'operation', items: [
                                {key: 'dwl_transform', icon: 'fa-random'},
                                {key: 'entity_read', icon: 'fa-download'},
                                {key: 'entity_write', icon: 'fa-upload'},
                                {key: 'invoke', icon: 'fa-bolt'},
                                {key: 'sql_query', icon: 'fa-table'},
                                {key: 'invoke_php', icon: 'fa-code'}
                            ]},
                            {key: 'file_operations', category: 'operation', items: [
                                {key: 'file_read', icon: 'fa-file-text-o'},
                                {key: 'file_write', icon: 'fa-pencil-square-o'},
                                {key: 'file_list', icon: 'fa-folder-open-o'},
                                {key: 'file_delete', icon: 'fa-trash-o'},
                                {key: 'file_rename', icon: 'fa-i-cursor'}
                            ]},
                            {key: 'notification', category: 'operation', items: [
                                {key: 'logger', icon: 'fa-list-alt'},
                                {key: 'event', icon: 'fa-flag-o'},
                                {key: 'email', icon: 'fa-envelope-o'},
                                {key: 'ms_teams', icon: 'fa-windows'}
                            ]}
                        ] %}
                        {% for section in sections %}
                            {# Element visibility is a System Configuration setting. Hidden items
                               are still RENDERED (with [hidden]) — the editor harvests each
                               type's category/icon/label from these nodes, and stored flows may
                               carry hidden types. A section with no visible item hides fully. #}
                            {% set visibleCount = section.items|filter(item => oro_config_value('aaxis_ontology.flow_element_' ~ item.key))|length %}
                            <div class="aaxis-flow-editor__toolbox-section"{% if visibleCount == 0 %} hidden{% endif %}>
                                <div class="aaxis-flow-editor__toolbox-section-title">
                                    {{ ('aaxis.ontology.flow_editor.toolbox.section.' ~ section.key)|trans }}
                                    <button type="button" class="aaxis-flow-editor__toolbox-section-toggle"
                                            data-role="toolbox-section-toggle"
                                            title="{{ 'aaxis.ontology.flow_editor.toolbox.collapse'|trans }}"
                                            aria-label="{{ 'aaxis.ontology.flow_editor.toolbox.collapse'|trans }}">
                                        <span class="fa fa-minus" aria-hidden="true"></span>
                                    </button>
                                </div>
                                {% for item in section.items %}
                                    <div class="aaxis-flow-editor__toolbox-item"
                                         {% if not oro_config_value('aaxis_ontology.flow_element_' ~ item.key) %}hidden{% endif %}
                                         data-step-type="{{ item.key }}"
                                         data-step-category="{{ section.category }}"
                                         data-step-icon="{{ item.icon }}"
                                         data-step-label="{{ ('aaxis.ontology.flow_editor.toolbox.item.' ~ item.key)|trans }}">
                                        <span class="fa {{ item.icon }} aaxis-flow-editor__toolbox-item-icon" aria-hidden="true"></span>
                                        {{ ('aaxis.ontology.flow_editor.toolbox.item.' ~ item.key)|trans }}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
