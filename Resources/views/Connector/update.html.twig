{% extends '@OroUI/actions/update.html.twig' %}

{% set formAction = entity.id ? path('aaxis_ontology_connector_update', {id: entity.id}) : path('aaxis_ontology_connector_create') %}

{% block navButtons %}
    {% import '@OroUI/macros.html.twig' as UI %}
    {{ parent() }}
    {{ UI.cancelButton(path('aaxis_ontology_connectors')) }}
    {% set html = '' %}
    {% if is_granted('aaxis_ontology_connector_view') %}
        {% set html = html ~ UI.saveAndCloseButton({'route': 'aaxis_ontology_connector_view', 'params': {'id': '$id'}}) %}
    {% endif %}
    {% if is_granted('aaxis_ontology_connector_update') %}
        {% set html = html ~ UI.saveAndStayButton({'route': 'aaxis_ontology_connector_update', 'params': {'id': '$id'}}) %}
    {% endif %}
    {{ UI.dropdownSaveButton({'html': html}) }}
{% endblock %}

{% block pageHeader %}
    {% if entity.id %}
        {% set breadcrumbs = {
            'entity': entity,
            'indexPath': path('aaxis_ontology_connectors'),
            'indexLabel': 'aaxis.ontology.connector.entity_plural_label'|trans,
            'entityTitle': entity.name|default('N/A'|trans)
        } %}
        {{ parent() }}
    {% else %}
        {% set title = 'oro.ui.create_entity'|trans({'%entityName%': 'aaxis.ontology.connector.entity_label'|trans}) %}
        {% include '@OroUI/page_title_block.html.twig' with { title: title } %}
    {% endif %}
{% endblock pageHeader %}

{% block content_data %}
    {% set id = 'aaxis-ontology-connector-edit' %}

    {# Config is read-only JSON, authored via the type-specific "Configure" popup; the component
       also guards Type switches (confirms before wiping the existing configuration). #}
    {% set configComponent %}
        <div data-page-component-module="aaxisontology/js/app/components/connector-config-component"
             data-page-component-options="{{ {
                 typeFieldId: form.type.vars.id,
                 configFieldId: form.config.vars.id,
                 connectorId: entity.id
             }|json_encode }}"></div>
    {% endset %}

    {% set dataBlocks = [{
        'title': 'aaxis.ontology.section.general'|trans,
        'subblocks': [{
            'data': [
                form_row(form.system),
                form_row(form.name),
                form_row(form.type),
                form_row(form.config),
                configComponent,
            ]
        }]
    }] %}
    {% set data = {'formErrors': form_errors(form), 'dataBlocks': dataBlocks} %}
    {{ parent() }}
{% endblock content_data %}
