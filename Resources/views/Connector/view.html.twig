{% extends '@OroUI/actions/view.html.twig' %}
{% import '@OroUI/macros.html.twig' as UI %}

{% block navButtons %}
    {% import '@OroUI/macros.html.twig' as UI %}
    {{ parent() }}
    {# Tests the SAVED configuration server-side (no secrets on the page to send back). #}
    <button type="button" class="btn" data-role="connector-test-stored">
        <span class="fa fa-plug" aria-hidden="true"></span>
        {{ 'aaxis.ontology.connector.test_button'|trans }}
    </button>
{% endblock navButtons %}

{% block pageHeader %}
    {% set breadcrumbs = {
        'entity': entity,
        'indexPath': path('aaxis_ontology_connectors'),
        'indexLabel': 'aaxis.ontology.connector.entity_plural_label'|trans,
        'entityTitle': entity.name|default('N/A'|trans)
    } %}
    {{ parent() }}
{% endblock pageHeader %}

{% block content_data %}
    {% set info %}
        {{ UI.renderProperty('aaxis.ontology.connector.system.label'|trans, entity.system.name|default('')) }}
        {{ UI.renderProperty('aaxis.ontology.connector.name.label'|trans, entity.name) }}
        {{ UI.renderProperty('aaxis.ontology.connector.type.label'|trans, ('aaxis.ontology.connector.type.' ~ entity.type)|trans) }}
        <div class="control-group">
            {# A caption for a read-only value, not a form control — so a span, not a <label>. #}
            <span class="control-label">{{ 'aaxis.ontology.connector.config.label'|trans }}</span>
            {# maskedConfig (not entity.config): secret values are replaced with ******** server-side #}
            <div class="controls"><pre>{{ maskedConfig ? maskedConfig|json_encode(constant('JSON_PRETTY_PRINT')) : '' }}</pre></div>
        </div>
        {# The title bar's Test button (navButtons) posts to the stored-config test endpoint and
           this component renders the per-step outcome here, under the configuration. #}
        <div data-page-component-module="aaxisontology/js/app/components/connector-view-test-component"
             data-page-component-options="{{ {connectorId: entity.id}|json_encode }}">
            <div class="aaxis-connector-test" data-role="connector-test-result" hidden></div>
        </div>
    {% endset %}

    {% set dataBlocks = [{
        'title': 'aaxis.ontology.section.general'|trans,
        'subblocks': [{'data': [info]}]
    }] %}

    {% set id = 'aaxis-ontology-connector-view' %}
    {% set data = {'dataBlocks': dataBlocks} %}
    {{ parent() }}
{% endblock content_data %}
